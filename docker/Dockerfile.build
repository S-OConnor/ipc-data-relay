# ipc-data-relay build container.
#
# Compiles every product (bridge, receiver, test publisher, control tool) and
# installs stripped binaries into /opt/ipc-relay, which the runtime images
# copy from. The source and build trees are kept, so this image can also run
# the tests, tools/capture_inspect.py and cppcheck (the CI lint).
#
#   docker build -f docker/Dockerfile.build -t ipc-relay-build .
#   docker build -f docker/Dockerfile.build --build-arg RUN_TESTS=true -t ipc-relay-build .
#
# Build context: repository root.

ARG DEBIAN_RELEASE=bookworm
FROM debian:${DEBIAN_RELEASE}

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential cmake pkg-config libzmq3-dev python3 cppcheck ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

ARG CMAKE_BUILD_TYPE=Release
RUN cmake -S . -B /build -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} -DIPCRELAY_WARNINGS_AS_ERRORS=ON \
 && cmake --build /build -j"$(nproc)"

# true = run the full CTest suite (unit + multicast-on-loopback integration).
ARG RUN_TESTS=false
RUN if [ "${RUN_TESTS}" = "true" ]; then ctest --test-dir /build --output-on-failure; fi

RUN cmake --install /build --prefix /opt/ipc-relay --strip

CMD ["bash"]
