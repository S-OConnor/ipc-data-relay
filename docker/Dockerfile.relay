# ipc-relay-bridge runtime image: ZeroMQ IPC SUB -> UDP multicast.
#
# Takes the stripped binary from the build image and adds only the runtime
# dependency (libzmq5). Build the build image first:
#
#   docker build -f docker/Dockerfile.build -t ipc-relay-build .
#   docker build -f docker/Dockerfile.relay -t ipc-relay-relay .
#
# Build context: repository root. The default configuration expects the
# publishers' IPC sockets in /run/ipc-relay (share it as a volume).

ARG BUILD_IMAGE=ipc-relay-build:latest
ARG DEBIAN_RELEASE=bookworm
FROM ${BUILD_IMAGE} AS build

FROM debian:${DEBIAN_RELEASE}-slim

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends libzmq5 \
 && rm -rf /var/lib/apt/lists/*

# Same UID in every runtime image so IPC sockets in a shared volume are
# reachable between containers.
RUN useradd --system --uid 10001 --user-group --no-create-home ipcrelay \
 && install -d -o ipcrelay -g ipcrelay /run/ipc-relay

COPY --from=build /opt/ipc-relay/bin/ipc-relay-bridge /usr/local/bin/
COPY docker/config/bridge.conf /etc/ipc-relay/bridge.conf

USER ipcrelay
ENTRYPOINT ["ipc-relay-bridge"]
CMD ["--config", "/etc/ipc-relay/bridge.conf"]
